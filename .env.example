# Copy to .env and fill in. .env is git-ignored and bin/bouchet never syncs it; nothing personal lives in the repo.
# Plain NAME=value lines, no quotes. A variable already exported in your shell wins over this file.
# bin/bouchet passes the cluster-side settings on over ssh, and Slurm jobs inherit them. On the cluster itself,
# bouchet/env.local.sh (not synced) can set the same variables, and wins.

# Required: the project directory on the cluster (code, .venv, data, runs)
NAMES_REMOTE=/nfs/roberts/project/<pi_group>/<netid>/turion
# Slurm account for training jobs and the setup job. Unset: your Slurm default account.
NAMES_ACCOUNT=<pi_group>

# Optional
# ssh host or ~/.ssh/config alias (default bouchet.ycrc.yale.edu, as your local user name)
#NAMES_HOST=<netid>@bouchet.ycrc.yale.edu
# Hugging Face cache on the cluster (default $NAMES_REMOTE/hf_cache)
#NAMES_HF_HOME=
# setup job (bouchet/setup-job.sh, bouchet/setup.sh)
#NAMES_SETUP_PARTITION=devel
#NAMES_SETUP_MEM=16G
#NAMES_PYTHON=/usr/bin/python3.11
